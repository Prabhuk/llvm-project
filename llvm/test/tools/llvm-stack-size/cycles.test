## Recursion makes the estimate a lower bound: a recursive function may call
## itself any number of times. Every member of a recursive component on the
## path is listed, since all of their frames count once.

# RUN: yaml2obj %s -o %t
# RUN: llvm-stack-size %t | FileCheck %s --match-full-lines
# RUN: llvm-stack-size %t --entry-point=sink | FileCheck %s --check-prefix=SINK --match-full-lines

#      CHECK:Entry point: main (0x1000)
# CHECK-NEXT:  Stack usage: at least 120 bytes (lower bound)
# CHECK-NEXT:  Lower bound because:
# CHECK-NEXT:    cycle: main (0x1000)
# CHECK-NEXT:    cycle: a (0x2000), b (0x3000)
# CHECK-NEXT:  Max stack path:
# CHECK-NEXT:    main (0x1000): 16 bytes
# CHECK-NEXT:    a (0x2000): 32 bytes
# CHECK-NEXT:    b (0x3000): 64 bytes
# CHECK-NEXT:    sink (0x4000): 8 bytes

#      SINK:Entry point: sink (0x4000)
# SINK-NEXT:  Stack usage: 8 bytes

--- !ELF
FileHeader:
  Class:   ELFCLASS64
  Data:    ELFDATA2LSB
  Type:    ET_EXEC
  Machine: EM_AARCH64
  Entry:   0x1000
Sections:
  - Name:    .text
    Type:    SHT_PROGBITS
    Flags:   [ SHF_ALLOC, SHF_EXECINSTR ]
    Address: 0x1000
    Size:    0x10000
  - Name: .stack_sizes
    Type: SHT_PROGBITS
    Entries:
      - Address: 0x1000
        Size:    16
      - Address: 0x2000
        Size:    32
      - Address: 0x3000
        Size:    64
      - Address: 0x4000
        Size:    8
  - Name: .llvm.callgraph
    Type: SHT_LLVM_CALL_GRAPH
    ContentArray: [
      0x00,                                           ## Version
      0x02,                                           ## Flags
      0x00, 0x10, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, ## Function 0x1000
      0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, ## Type ID 0x0
      0x02,                                           ## 2 direct callees
      0x00, 0x10, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, ## Callee 0x1000
      0x00, 0x20, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, ## Callee 0x2000
      0x00,                                           ## Version
      0x02,                                           ## Flags
      0x00, 0x20, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, ## Function 0x2000
      0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, ## Type ID 0x0
      0x01,                                           ## 1 direct callees
      0x00, 0x30, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, ## Callee 0x3000
      0x00,                                           ## Version
      0x02,                                           ## Flags
      0x00, 0x30, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, ## Function 0x3000
      0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, ## Type ID 0x0
      0x02,                                           ## 2 direct callees
      0x00, 0x20, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, ## Callee 0x2000
      0x00, 0x40, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, ## Callee 0x4000
      0x00,                                           ## Version
      0x00,                                           ## Flags
      0x00, 0x40, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, ## Function 0x4000
      0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, ## Type ID 0x0
    ]
Symbols:
  - Name:    main
    Type:    STT_FUNC
    Section: .text
    Value:   0x1000
  - Name:    a
    Type:    STT_FUNC
    Section: .text
    Value:   0x2000
  - Name:    b
    Type:    STT_FUNC
    Section: .text
    Value:   0x3000
  - Name:    sink
    Type:    STT_FUNC
    Section: .text
    Value:   0x4000
