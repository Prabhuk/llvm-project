## Identical code folding leaves the records and .stack_sizes entries of all
## folded functions at one address. The function gets the union of the callees
## and the largest frame.

# RUN: yaml2obj %s -o %t
# RUN: llvm-stack-size %t | FileCheck %s --match-full-lines

#      CHECK:Entry point: main (0x1000)
# CHECK-NEXT:  Stack usage: 164 bytes
# CHECK-NEXT:  Max stack path:
# CHECK-NEXT:    main (0x1000): 16 bytes
# CHECK-NEXT:    folded_a (0x2000): 48 bytes
# CHECK-NEXT:    big (0x4000): 100 bytes

--- !ELF
FileHeader:
  Class:   ELFCLASS64
  Data:    ELFDATA2LSB
  Type:    ET_EXEC
  Machine: EM_AARCH64
  Entry:   0x1000
Sections:
  - Name:    .text
    Type:    SHT_PROGBITS
    Flags:   [ SHF_ALLOC, SHF_EXECINSTR ]
    Address: 0x1000
    Size:    0x10000
  - Name: .stack_sizes
    Type: SHT_PROGBITS
    Entries:
      - Address: 0x1000
        Size:    16
      - Address: 0x2000
        Size:    24
      - Address: 0x2000
        Size:    48
      - Address: 0x3000
        Size:    8
      - Address: 0x4000
        Size:    100
  - Name: .llvm.callgraph
    Type: SHT_LLVM_CALL_GRAPH
    ContentArray: [
      0x00,                                           ## Version
      0x02,                                           ## Flags
      0x00, 0x10, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, ## Function 0x1000
      0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, ## Type ID 0x0
      0x01,                                           ## 1 direct callees
      0x00, 0x20, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, ## Callee 0x2000
      0x00,                                           ## Version
      0x02,                                           ## Flags
      0x00, 0x20, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, ## Function 0x2000
      0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, ## Type ID 0x0
      0x01,                                           ## 1 direct callees
      0x00, 0x30, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, ## Callee 0x3000
      0x00,                                           ## Version
      0x02,                                           ## Flags
      0x00, 0x20, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, ## Function 0x2000
      0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, ## Type ID 0x0
      0x01,                                           ## 1 direct callees
      0x00, 0x40, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, ## Callee 0x4000
      0x00,                                           ## Version
      0x00,                                           ## Flags
      0x00, 0x30, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, ## Function 0x3000
      0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, ## Type ID 0x0
      0x00,                                           ## Version
      0x00,                                           ## Flags
      0x00, 0x40, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, ## Function 0x4000
      0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, ## Type ID 0x0
    ]
Symbols:
  - Name:    main
    Type:    STT_FUNC
    Section: .text
    Value:   0x1000
  - Name:    folded_a
    Type:    STT_FUNC
    Section: .text
    Value:   0x2000
  - Name:    folded_b
    Type:    STT_FUNC
    Section: .text
    Value:   0x2000
  - Name:    small
    Type:    STT_FUNC
    Section: .text
    Value:   0x3000
  - Name:    big
    Type:    STT_FUNC
    Section: .text
    Value:   0x4000
