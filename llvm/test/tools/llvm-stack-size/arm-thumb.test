## On ARM, bit 0 of a Thumb function's address marks the instruction set. It
## is cleared everywhere: in the entry point, the symbols, .stack_sizes and
## .llvm.callgraph.

# RUN: yaml2obj %s -o %t
# RUN: llvm-stack-size %t | FileCheck %s --match-full-lines
# RUN: llvm-stack-size %t --entry-point=0x2001 | FileCheck %s --check-prefix=LEAF --match-full-lines

#      CHECK:Entry point: thumb_main (0x1000)
# CHECK-NEXT:  Stack usage: 20 bytes
# CHECK-NEXT:  Max stack path:
# CHECK-NEXT:    thumb_main (0x1000): 12 bytes
# CHECK-NEXT:    thumb_leaf (0x2000): 8 bytes

#      LEAF:Entry point: thumb_leaf (0x2000)
# LEAF-NEXT:  Stack usage: 8 bytes

--- !ELF
FileHeader:
  Class:   ELFCLASS32
  Data:    ELFDATA2LSB
  Type:    ET_EXEC
  Machine: EM_ARM
  Entry:   0x1001
Sections:
  - Name:    .text
    Type:    SHT_PROGBITS
    Flags:   [ SHF_ALLOC, SHF_EXECINSTR ]
    Address: 0x1000
    Size:    0x10000
  - Name: .stack_sizes
    Type: SHT_PROGBITS
    Entries:
      - Address: 0x1001
        Size:    12
      - Address: 0x2001
        Size:    8
  - Name: .llvm.callgraph
    Type: SHT_LLVM_CALL_GRAPH
    ContentArray: [
      0x00,                                           ## Version
      0x02,                                           ## Flags
      0x01, 0x10, 0x00, 0x00,                         ## Function 0x1001
      0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, ## Type ID 0x0
      0x01,                                           ## 1 direct callees
      0x01, 0x20, 0x00, 0x00,                         ## Callee 0x2001
      0x00,                                           ## Version
      0x00,                                           ## Flags
      0x01, 0x20, 0x00, 0x00,                         ## Function 0x2001
      0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, ## Type ID 0x0
    ]
Symbols:
  - Name:    thumb_main
    Type:    STT_FUNC
    Section: .text
    Value:   0x1001
  - Name:    thumb_leaf
    Type:    STT_FUNC
    Section: .text
    Value:   0x2001
