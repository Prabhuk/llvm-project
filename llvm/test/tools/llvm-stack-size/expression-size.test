## The text report prints an expression that names at most 64 unknowns, and
## gives its size instead beyond that, since a longer one is not readable. main
## calls a chain of 65 functions without a frame size, so its expression has 65
## unknowns, and the expression of the second function of the chain has 64.
## The chain has no symbols, so its functions are named by address.

# RUN: yaml2obj %s -o %t
# RUN: llvm-stack-size %t --entry-point=main | FileCheck %s --check-prefix=MAIN --match-full-lines
# RUN: llvm-stack-size %t --entry-point=0x2010 | FileCheck %s --check-prefix=SECOND --match-full-lines

#      MAIN:Entry point: main (0x1000)
# MAIN-NEXT:  Stack usage: at least 16 bytes (lower bound)
# MAIN-NEXT:  Stack usage expression: 1 term over 65 unknowns, too large to print
# MAIN-NEXT:  Lower bound because:
# MAIN-NEXT:    unknown frame size: 0x2000 (0x2000)
#      MAIN:    unknown frame size: 0x2090 (0x2090)
# MAIN-NEXT:    and 55 more functions without a frame size

#      SECOND:Entry point: 0x2010 (0x2010)
# SECOND-NEXT:  Stack usage: at least 0 bytes (lower bound)
# SECOND-NEXT:  Stack usage expression: {{(frame\(0x[0-9a-f]+\) \+ ){63}frame\(0x[0-9a-f]+\)}}

--- !ELF
FileHeader:
  Class:   ELFCLASS64
  Data:    ELFDATA2LSB
  Type:    ET_EXEC
  Machine: EM_AARCH64
Sections:
  - Name:    .text
    Type:    SHT_PROGBITS
    Flags:   [ SHF_ALLOC, SHF_EXECINSTR ]
    Address: 0x1000
    Size:    0x10000
  - Name: .stack_sizes
    Type: SHT_PROGBITS
    Entries:
      - Address: 0x1000
        Size:    16
  - Name: .llvm.callgraph
    Type: SHT_LLVM_CALL_GRAPH
