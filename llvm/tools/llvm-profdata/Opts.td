include "llvm/Option/OptParser.td"

class F<string letter, string help> : Flag<["-"], letter>, HelpText<help>;
class FF<string name, string help> : Flag<["--"], name>, HelpText<help>;

multiclass Eq<string name, string help> {
  def NAME #_EQ : Joined<["--"], name #"=">, HelpText<help>;
  def : Separate<["--"], name>, Alias<!cast<Joined>(NAME #_EQ)>;
}

def sc_show : SubCommand<"show", "Takes a profile data file and displays the profiles. See detailed documentation in https://llvm.org/docs/CommandGuide/llvm-profdata.html#profdata-show">;
def sc_order : SubCommand<"order", "Reads temporal profiling traces from a profile and outputs a function order that reduces the number of page faults for those traces. See detailed documentation in https://llvm.org/docs/CommandGuide/llvm-profdata.html#profdata-order">;
def sc_overlap : SubCommand<"overlap", "Computes and displays the overlap between two profiles. See detailed documentation in https://llvm.org/docs/CommandGuide/llvm-profdata.html#profdata-overlap>;
def sc_merge: SubCommand<"merge", "Takes several profiles and merge them together. See detailed documentation in https://llvm.org/docs/CommandGuide/llvm-profdata.html#profdata-merge">;

def help : FF<"help", "Display this help">;
def : F<"h", "Alias for --help">, Alias<help>;
def version : FF<"version", "Display the version">;
def : F<"V", "Alias for --version">, Alias<version>;
defm output : Eq<"output", "Output file", [sc_show, sc_order, sc_overlap, sc_merge]>;
defm : Eq<"o", "Alias for --output">, Alias<output>;
defm  : Eq<"", "Profile kind:">;
defm  : Eq<"", "<profdata-file>">;
defm max_debug_info_correlation_warnings : Eq<"max-debug-info-correlation-warnings", "The maximum number of warnings to emit when correlating profile from debug info (0 = no limit)", [sc_show, sc_merge]>;
defm profiled_binary : Eq<"profiled-binary", "Path to binary from which the profile was collected.", [sc_show, sc_merge]>;
defm debug_info : Eq<"debug-info", "For show, read and extract profile metadata from debug info and show the functions it found. For merge, use the provided debug info to correlate the raw profile.", [sc_show, sc_merge]>;
defm binary_file : Eq<"binary-file", "For merge, use the provided unstripped binary to correlate the raw profile.", [sc_merge]>;
defm debug_file_directory : Eq<"debug-file-directory", "Directories to search for object files by build ID">;
def debuginfod : FF<"debuginfod", "Enable debuginfod", [sc_merge]>;
defm correlate : Eq<"correlate", "Use debug-info or binary correlation to correlate profiles with build id fetcher">;
defm function : Eq<"function", "Only functions matching the filter are shown in the output. For overlapping CSSPGO, this takes a function name with calling context.", [sc_show, sc_overlap, sc_merge]>;
defm  : Eq<"", "<filename...>">;
defm weighted_input : Eq<"weighted-input", "<weight>,<filename>">;
defm  : Eq<"", "Format of output profile">;
defm input_files : Eq<"input-files", "Path to file containing newline-separated [<weight>,]<filename> entries">;
defm : Eq<"f", "Alias for --input-files">, Alias<input-files>;
def dump_input_file_list : FF<"dump-input-file-list", "Dump the list of input files and their weights, then exit">;
defm remapping_file : Eq<"remapping-file", "Symbol remapping file">;
defm : Eq<"r", "Alias for --remapping-file">, Alias<remapping-file>;
def use_md5 : FF<"use-md5", "Choose to use MD5 to represent string in name table (only meaningful for -extbinary)">;
def compress_all_sections : FF<"compress-all-sections", "Compress all sections when writing the profile (only meaningful for -extbinary)">;
def sample_merge_cold_context : FF<"sample-merge-cold-context", "Merge context sample profiles whose count is below cold threshold">;
def sample_trim_cold_context : FF<"sample-trim-cold-context", "Trim context sample profiles whose count is below cold threshold">;
defm sample_frame_depth_for_cold_context : Eq<"sample-frame-depth-for-cold-context", "Keep the last K frames while merging cold profile. 1 means the context-less base profile">;
defm output_size_limit : Eq<"output-size-limit", "Trim cold functions until profile size is below specified limit in bytes. This uses a heursitic and functions may be excessively trimmed">;
def gen_partial_profile : FF<"gen-partial-profile", "Generate a partial profile (only meaningful for -extbinary)">;
def split_layout : FF<"split-layout", "Split the profile to two sections with one containing sample profiles with inlined functions and the other without (only meaningful for -extbinary)">;
defm supplement_instr_with_sample : Eq<"supplement-instr-with-sample", "Supplement an instr profile with sample profile, to correct the profile unrepresentativeness issue. The sample profile is the input of the flag. Output will be in instr format (The flag only works with -instr)">;
defm zero_counter_threshold : Eq<"zero-counter-threshold", "For the function which is cold in instr profile but hot in sample profile, if the ratio of the number of zero counters divided by the total number of counters is above the threshold, the profile of the function will be regarded as being harmful for performance and will be dropped.">;
defm suppl_min_size_threshold : Eq<"suppl-min-size-threshold", "If the size of a function is smaller than the threshold, assume it can be inlined by PGO early inliner and it won't be adjusted based on sample profile.">;
defm instr_prof_cold_threshold : Eq<"instr-prof-cold-threshold", "User specified cold threshold for instr profile which will override the cold threshold got from profile summary. ">;
defm temporal_profile_trace_reservoir_size : Eq<"temporal-profile-trace-reservoir-size", "The maximum number of stored temporal profile traces (default: 100)">;
defm temporal_profile_max_trace_length : Eq<"temporal-profile-max-trace-length", "The maximum length of a single temporal profile trace (default: 10000)">;
defm no_function : Eq<"no-function", "Exclude functions matching the filter from the output.">;
defm failure_mode : Eq<"failure-mode", "Failure mode:">;
def sparse : FF<"sparse", "Generate a sparse profile (only meaningful for -instr)">;
defm num_threads : Eq<"num-threads", "Number of merge threads to use (default: autodetect)">;
defm : Eq<"j", "Alias for --num-threads">, Alias<num-threads>;
defm prof_sym_list : Eq<"prof-sym-list", "Path to file containing the list of function symbols used to populate profile symbol list">;
defm convert_sample_profile_layout : Eq<"convert-sample-profile-layout", "Convert the generated profile to a profile with a new layout">;
def drop_profile_symbol_list : FF<"drop-profile-symbol-list", "Drop the profile symbol list when merging AutoFDO profiles (only meaningful for -sample)">;
def keep_vtable_symbols : FF<"keep-vtable-symbols", "If true, keep the vtable symbols in indexed profiles">;
def write_prev_version : FF<"write-prev-version", "Write the previous version of indexed format, to enable some forward compatibility.">;
defm memprof_version : Eq<"memprof-version", "Specify the version of the memprof format to use">;
def memprof_full_schema : FF<"memprof-full-schema", "Use the full schema for serialization">;
def memprof_random_hotness : FF<"memprof-random-hotness", "Generate random hotness values">;
defm memprof_random_hotness_seed : Eq<"memprof-random-hotness-seed", "Random hotness seed to use (0 to generate new seed)">;
defm  : Eq<"", "<base profile file>">;
defm  : Eq<"", "<test profile file>">;
defm similarity_cutoff : Eq<"similarity-cutoff", "For sample profiles, list function names (with calling context for csspgo) for overlapped functions with similarities below the cutoff (percentage times 10000).">;
def cs : FF<"cs", "For context sensitive PGO counts. Does not work with CSSPGO.">;
defm value_cutoff : Eq<"value-cutoff", "Function level overlap information for every function (with calling context for csspgo) in test profile with max count value greater than the parameter value">;
def counts : FF<"counts", "Show counter values for shown functions">;
defm show_format : Eq<"show-format", "Emit output in the selected format if supported">;
def text : FF<"text", "Show instr profile data in text dump format">;
def json : FF<"json", "Show sample profile data in the JSON format (deprecated, please use --show-format=json)">;
def ic_targets : FF<"ic-targets", "Show indirect call site target values for shown functions">;
def show_vtables : FF<"show-vtables", "Show vtable names for shown functions">;
def memop_sizes : FF<"memop-sizes", "Show the profiled sizes of the memory intrinsic calls for shown functions">;
def detailed_summary : FF<"detailed-summary", "Show detailed profile summary">;
defm  : Eq<"", "800000,901000,999999">;
def hot_func_list : FF<"hot-func-list", "Show profile summary of a list of hot functions">;
def all_functions : FF<"all-functions", "Details for each and every function">;
def showcs : FF<"showcs", "Show context sensitive counts">;
defm  : Eq<"", "Profile kind supported by show:">;
defm topn : Eq<"topn", "Show the list of functions with the largest internal counts">;
defm value_cutoff : Eq<"value-cutoff", "Set the count value cutoff. Functions with the maximum count less than this value will not be printed out. (Default is 0)">;
def list_below_cutoff : FF<"list-below-cutoff", "Only output names of functions whose max count values are below the cutoff value">;
def show_prof_sym_list : FF<"show-prof-sym-list", "Show profile symbol list if it exists in the profile. ">;
def show_sec_info_only : FF<"show-sec-info-only", "Show the information of each section in the sample profile. The flag is only usable when the sample profile is in extbinary format">;
def binary_ids : FF<"binary-ids", "Show binary ids in the profile. ">;
def temporal_profile_traces : FF<"temporal-profile-traces", "Show temporal profile traces in the profile.">;
def covered : FF<"covered", "Show only the functions that have been executed.">;
def profile_version : FF<"profile-version", "Show profile version. ">;
defm num_test_traces : Eq<"num-test-traces", "Keep aside the last <num-test-traces> traces in the profile when computing the function order and instead use them to evaluate that order">;
defm fs_discriminator_pass : Eq<"fs-discriminator-pass", "Zero out the discriminator bits for the FS discrimiantor pass beyond this value. The enum values are defined in Support/Discriminator.h">;
